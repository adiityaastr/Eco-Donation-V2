left to right direction
actor "Pengguna\n(warga)" as U
actor "Kurir" as K
actor "Operator /\npengembang" as O
rectangle "Sistem Eco-Donation\n(backend-api, user-app, courier-app)" as S #D5E3F0
cloud "Every.org\nPartner API" as E
cloud "Photon API\n(geocoding)" as P
cloud "Tile peta OSM HOT / Esri" as M
U --> S : akun, permintaan jemput,\npersetujuan timbangan, donasi
S --> U : estimasi poin, posisi kurir,\nnotifikasi, saldo, dampak, lencana
K --> S : ambil tugas, lokasi GPS,\nberat aktual
S --> K : order baru, detail tugas,\nkode dan QR verifikasi
O --> S : kampanye lokal dan akun kurir (seed)
S --> E : telusuri dan cari nirlaba
E --> S : profil organisasi
S --> P : teks alamat / koordinat
P --> S : saran alamat
M --> S : gambar peta

@enduml
