|Kurir|
start
repeat
  :Kirim lokasi tiap 10 detik;
  |Sistem|
  :Hitung jarak (haversine) dan ETA;
  :Kirim order:location ke pengguna;
  if (Jarak <= 500 m pertama kali?) then (ya)
    :Kirim order:near;
  endif
  |Pengguna|
  :Pantau kurir di peta;
  |Kurir|
repeat while (Belum tiba?) is (ya)
->tiba;
:Tekan Saya sudah tiba;
|Sistem|
:Set arrived, kirim order:arrived;
|Kurir|
:Timbang dan isi berat aktual
semua item;
|Sistem|
if (Semua item terisi?) then (tidak)
  :Tolak 400 INVALID_ITEMS;
  stop
else (ya)
endif
:Simpan berat, set pending_verification;
:Buat kode, simpan hash,
berlaku 30 menit;
|Kurir|
:Tampilkan QR dan kode;
stop

@enduml
