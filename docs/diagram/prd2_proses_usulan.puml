skinparam ActivityEndColor #1E3A5F
skinparam StateStartColor #1E3A5F
skinparam StateEndColor #1E3A5F
skinparam ActivityBarColor #1E3A5F


|Pengguna|
start
:Memilih kategori sampah dan estimasi berat;
:Melihat estimasi poin;
:Menentukan titik jemput di peta dan jadwal;
:Mengonfirmasi penjemputan;
|Sistem|
:Membuat order berstatus waiting;
:Menyiarkan order baru ke semua kurir;
|Kurir|
:Mengambil tugas;
|Sistem|
:Mengunci order untuk kurir tersebut;
:Memberi tahu pengguna;
|Kurir|
:Berangkat dan berbagi lokasi tiap 10 detik;
|Sistem|
:Meneruskan posisi, jarak, dan ETA ke pengguna;
|Kurir|
:Tiba, menimbang, mengisi berat aktual;
|Sistem|
:Menghitung poin dari berat aktual;
:Membuat kode 6 karakter dan QR (30 menit);
|Kurir|
:Menampilkan QR di layar HP;
|Pengguna|
:Memindai QR atau mengetik kode;
:Memeriksa rincian timbangan;
if (Sesuai?) then (setujui)
  |Sistem|
  :Menyelesaikan order, menambah saldo poin,
  memperbarui dampak dan lencana;
  |Pengguna|
  :Mendonasikan poin ke kampanye
  lokal atau global (minimal 1.000);
  |Sistem|
  :Memotong saldo dan menambah progres kampanye;
  stop
else (tolak)
  |Sistem|
  :Mengembalikan order ke status arrived;
  |Kurir|
  :Menimbang ulang bersama pengguna;
  stop
endif

@enduml
